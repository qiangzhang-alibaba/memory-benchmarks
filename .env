# =============================================================================
# Memory Benchmarks — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values:  cp .env.example .env

# ---------------------------------------------------------------------------
# Required: LLM Provider (for answer generation, judging)
# ---------------------------------------------------------------------------
OPENAI_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
OPENAI_API_KEY=sk-xxxx

# Answerer / Judge model names (CLI args --answerer-model / --judge-model override these)
# qwen-flash（或 qwen3.5-4b / qwen3.5-9b）
ANSWERER_MODEL=qwen3.6-plus
JUDGE_MODEL=qwen3.6-plus

# Thinking mode for qwen3 series models (false = disabled, faster plain replies)
QWEN3_ENABLE_THINKING=false

# Optional: Other LLM providers (for answer/judge models)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# ---------------------------------------------------------------------------
# Mem0 Backend — Mem0 OSS-compatible (original /memories + /search endpoints)
# ---------------------------------------------------------------------------
# MEM0_BACKEND=mem0
MEM0_BACKEND=polarmem
# MEM0_HOST=http://100.69.96.30:8080
MEM0_HOST=http://11.163.9.208:8080
MEM0_API_KEY=dev_token
